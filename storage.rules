rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Musician profile photos
    match /musician-profiles/{fileName} {
      allow write: if request.auth != null;
      allow read: if true;
    }
    
    // Event posters
    match /event-posters/{fileName} {
      allow write: if request.auth != null;
      allow read: if true;
    }

    // Publishing application uploads
    match /publishing-applications/{allPaths=**} {
      allow write: if request.auth != null;
      allow read: if true;
    }

    // Viewer document uploads
    match /viewer-documents/{allPaths=**} {
      allow write: if request.auth != null;
      allow read: if true;
    }
    
    // General rule for all media & recording assets (Black Diaspora Symphony, studio, viewer, etc.)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
